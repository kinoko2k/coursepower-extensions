{
  "manifest_version": 2,
  "name": "CoursePower Extensions",
  "version": "0.1.0",
  "description": "CoursePowerの拡張機能です。Firefoxのみ動作します。",
  "browser_action": {
    "default_title": "CoursePower",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tsufuj6e2@mozmail.com",
      "strict_min_version": "109.0"
    }
  }
}
