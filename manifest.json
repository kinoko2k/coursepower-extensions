{
  "manifest_version": 2,
  "name": "CoursePower Extensions",
  "version": "1.1.0",
  "description": "CoursePowerの拡張機能です。Firefoxをメインとしていますが、Chromeでも使用可能です。",
  "browser_action": {
    "default_title": "CoursePower",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content/constants.js",
        "src/content/autologin.js",
        "src/content/bulk-download.js",
        "src/content/session-timer.js",
        "src/content/auto-accordion.js",
        "src/content/error-redirect.js",
        "src/content/favicon.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "info@kinokoroom.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
